{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "functions": {
    "api/index.py": { "maxDuration": 60, "excludeFiles": "tests/**" }
  },
  "rewrites": [
    { "source": "/api/health", "destination": "/api/index?_route=health" },
    { "source": "/api/workspace", "destination": "/api/index?_route=workspace" },
    { "source": "/api/services/status", "destination": "/api/index?_route=services/status" },
    { "source": "/api/services/test", "destination": "/api/index?_route=services/test" },
    { "source": "/api/auth/login", "destination": "/api/index?_route=auth/login" },
    { "source": "/api/auth/logout", "destination": "/api/index?_route=auth/logout" },
    { "source": "/api/auth/session", "destination": "/api/index?_route=auth/session" },
    { "source": "/api/projects", "destination": "/api/index?_route=projects" },
    { "source": "/api/project", "destination": "/api/index?_route=project" },
    { "source": "/api/milestones", "destination": "/api/index?_route=milestones" },
    { "source": "/api/tasks", "destination": "/api/index?_route=tasks" },
    { "source": "/api/task-dependencies", "destination": "/api/index?_route=task-dependencies" },
    { "source": "/api/task_dependencies", "destination": "/api/index?_route=task_dependencies" },
    { "source": "/api/progress", "destination": "/api/index?_route=progress" },
    { "source": "/api/documents/upload", "destination": "/api/index?_route=documents/upload" },
    { "source": "/api/documents/finalize", "destination": "/api/index?_route=documents/finalize" },
    { "source": "/api/documents/extract", "destination": "/api/index?_route=documents/extract" },
    { "source": "/api/documents/search", "destination": "/api/index?_route=documents/search" },
    { "source": "/api/ai/chat", "destination": "/api/index?_route=ai/chat" },
    { "source": "/api/ai/analyze-project", "destination": "/api/index?_route=ai/analyze-project" },
    { "source": "/api/ai/proposal", "destination": "/api/index?_route=ai/proposal" },
    { "source": "/api/telegram/webhook", "destination": "/api/index?_route=telegram/webhook" },
    { "source": "/api/telegram/set-webhook", "destination": "/api/index?_route=telegram/set-webhook" },
    { "source": "/api/reminders/morning", "destination": "/api/index?_route=reminders/morning" },
    { "source": "/api/reminders/evening", "destination": "/api/index?_route=reminders/evening" }
  ]
}
