# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_LOGIN_PASSWORD_HASH=
JWT_SECRET=
SESSION_EXPIRY_HOURS=168
CRON_SECRET=
# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Preferred server-only key from Supabase API Keys (starts with sb_secret_).
SUPABASE_SECRET_KEY=
# Legacy fallback. Leave blank when SUPABASE_SECRET_KEY is set.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=project-files

# AI provider: deepseek (default) or mimo
AI_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_CONTEXT_CHARS=40000
DEEPSEEK_MAX_TOKENS=8192
CHAT_RETENTION_DAYS=7

# Xiaomi MiMo (kept as an alternative provider)
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
MIMO_TIMEOUT_SECONDS=60
MIMO_MAX_CONTEXT_CHARS=40000

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Documents
OCR_LANGUAGES=eng
MAX_UPLOAD_SIZE_MB=25
MAX_ZIP_FILES=200
MAX_ZIP_UNCOMPRESSED_MB=50
DOCUMENT_CHUNK_SIZE_CHARS=3000
DOCUMENT_CHUNK_OVERLAP_CHARS=300

# Application behaviour
DEFAULT_DAILY_WORK_HOURS=6
DEFAULT_APPROVAL_MODE=full_plan
LOG_LEVEL=INFO
